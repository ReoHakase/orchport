{
  "name": "orchport",
  "version": "0.1.0",
  "description": "Non-interactive env and port resolver for local multi-worktree web development",
  "homepage": "https://github.com/ReoHakase/orchport#readme",
  "bugs": {
    "url": "https://github.com/ReoHakase/orchport/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReoHakase/orchport.git"
  },
  "bin": {
    "orchport": "./bin/orchport.mjs"
  },
  "files": [
    "bin/",
    "dist/lib.js",
    "dist/lib.d.ts",
    "scripts/install-binary.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "hooks:install": "lefthook install",
    "postinstall": "node ./scripts/install-binary.mjs",
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts ./src/lib.ts --outdir ./dist --target bun && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir ./dist",
    "build:compile": "bun run scripts/release.ts compile",
    "release:archive": "bun run scripts/release.ts archive",
    "release:publish": "bun run scripts/release.ts publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "changeset:status": "bun run scripts/release.ts changeset-status origin/main",
    "test": "bun test test/",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "format": "bun oxfmt .",
    "format:check": "bun oxfmt . --check",
    "lint": "bun oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@gunshi/docs": "0.29.5",
    "@logtape/logtape": "2.0.7",
    "@logtape/pretty": "2.0.7",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.13",
    "@visulima/tabular": "3.1.3",
    "commitlint": "20.5.3",
    "gunshi": "0.29.5",
    "lefthook": "2.1.6",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "5.9.3",
    "valibot": "1.4.0",
    "yaml": "2.8.4"
  },
  "packageManager": "bun@1.3.13"
}
