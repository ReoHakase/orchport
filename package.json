{
  "name": "orchport",
  "version": "0.1.0",
  "description": "Non-interactive env and port resolver for local multi-worktree web development",
  "license": "MIT",
  "author": "",
  "bin": {
    "orchport": "./dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/lib.ts"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build:compile": "bun build ./src/index.ts --compile --outfile ./dist/orchport",
    "test": "bun test test/",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "format": "bun oxfmt .",
    "format:check": "bun oxfmt . --check",
    "lint": "bun oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logtape/logtape": "2.0.7",
    "@logtape/pretty": "2.0.7",
    "cli-table3": "0.6.5",
    "gunshi": "0.29.5",
    "valibot": "1.4.0",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@gunshi/docs": "0.29.5",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.13",
    "commitlint": "20.5.3",
    "lefthook": "2.1.6",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.13"
}
